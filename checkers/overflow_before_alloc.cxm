// Path-INSENSITIVE shape for INTEGER_OVERFLOW / OVERFLOW_BEFORE_WIDEN feeding
// an allocation: the size passed to malloc/realloc/alloca contains a
// multiplication (or shift) whose operand is a variable that is never
// compared with a relational operator anywhere in the function. Whether the
// product can wrap is exactly the value question the path-sensitive checker
// could not finish; here every unbounded multiplicand is a candidate.
include `C/C++`;

function varKey(r : astnode) : string? ->
    if r matches variableReference as v then (v.mangledName ?? v.identifier) else null endif;

function refsVar(e : expression, sym : string) : bool ->
    stripCasts(e) matches variableReference as r && varKey(r) == sym;

function sizeArg(c : astnode) : expression? ->
    if c matches functionCall as call then
        (let nm = call.calledFunction.identifier ?? "" in
         if nm == "malloc" || nm == "alloca" || nm == "xmalloc" then call.argumentList[0]
         elsif nm == "realloc" || nm == "xrealloc" then call.argumentList[1]
         else null endif)
    else null endif;

function root(n : astnode) : astnode ->
    if n.parent matches NonNull as p then root(p) else n endif;

function isRelational(n : astnode) : bool ->
    n matches binaryOperator as b
    && (b.operator == `<` || b.operator == `<=` || b.operator == `>` || b.operator == `>=`);

function everCompared(sym : string, fn : astnode) : bool ->
    exists b in allMatchingCodeIn(binaryOperator, fn)
        where isRelational(b) && (refsVar(b.lhsExpression, sym) || refsVar(b.rhsExpression, sym));

// is there a * or << inside e with a variable operand never compared in fn
function hasUnboundedFactor(e : expression, fn : astnode) : bool ->
    exists m in allMatchingCodeIn(binaryOperator, e)
        where (m.operator == `*` || m.operator == `<<`)
              && ((varKey(stripCasts(m.lhsExpression)) matches NonNull as l && !everCompared(l, fn))
                  || (varKey(stripCasts(m.rhsExpression)) matches NonNull as r && !everCompared(r, fn)));

checker {
    name = "PATHOUT_CANDIDATE_OVERFLOW_BEFORE_ALLOC";
    reports = for c in globalset allFunctionCode
        where sizeArg(c) matches NonNull as sz
           && hasUnboundedFactor(sz, root(c))
        : { events = [ { description = "Candidate: the allocation size multiplies a variable that is never compared in this function."
                                       + " Path-insensitive; whether it can wrap decides it.";
                         location = c.location; } ]; };
};
